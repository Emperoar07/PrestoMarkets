{
  "name": "presto-markets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && node -e \"require('fs').rmSync('.next/cache', { recursive: true, force: true })\" && node scripts/prepare-cloudflare-pages-git-output.mjs",
    "build:cloudflare": "node scripts/build-worker-market-seed.mjs && opennextjs-cloudflare build && node scripts/bundle-cloudflare-shards.mjs && node -e \"require('fs').rmSync('.open-next/assets/_redirects', { force: true })\"",
    "refresh:worker-seed": "node scripts/build-worker-market-seed.mjs",
    "preview:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy:cloudflare": "npm run build:cloudflare && node scripts/deploy-cloudflare-workers.mjs && node scripts/deploy-cloudflare-pages.mjs",
    "deploy:cloudflare:pages": "node scripts/deploy-cloudflare-pages.mjs",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "verify": "npm run typecheck && npm test -- --run && npm run build && npm run test:contracts",
    "test:contracts": "hardhat test",
    "deploy:arc": "hardhat run scripts/deploy-arc.cjs --network arc",
    "deploy:arc:v2": "hardhat run scripts/deploy-arc-v2.cjs --network arc",
    "db:migrate": "node scripts/apply-migration.cjs",
    "agent-cli": "ts-node scripts/agent-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@circle-fin/adapter-viem-v2": "^1.11.1",
    "@circle-fin/app-kit": "^1.6.1",
    "@circle-fin/developer-controlled-wallets": "^10.3.1",
    "@circle-fin/modular-wallets-core": "^1.0.13",
    "@circle-fin/w3s-pw-web-sdk": "^1.1.11",
    "@circle-fin/x402-batching": "^3.0.4",
    "@google/generative-ai": "^0.24.1",
    "@neondatabase/serverless": "^1.1.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@openzeppelin/contracts": "^5.4.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.100.10",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.4.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "^2.49.3",
    "wagmi": "^2.19.5",
    "x402": "^1.2.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "chai": "^4.5.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "ethers": "^6.17.0",
    "happy-dom": "^20.9.0",
    "hardhat": "^2.28.6",
    "hardhat-gas-reporter": "^2.3.0",
    "postcss": "^8.5.10",
    "solidity-coverage": "^0.8.17",
    "solmate": "^6.8.0",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.7",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "undici": "^6.27.0",
    "ws": "^8.18.3",
    "bn.js": "^4.12.3",
    "cookie": "^0.7.2",
    "tmp": "^0.2.5",
    "serialize-javascript": "^6.0.2",
    "postcss": "^8.5.10",
    "uuid": "^11.1.1",
    "websocket-driver": ">=0.7.5"
  }
}
