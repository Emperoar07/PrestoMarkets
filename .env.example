NEXT_PUBLIC_CIRCLE_GATEWAY_ENABLED=false

NEXT_PUBLIC_PRESTO_AGENT_RESOLVE_FEE_USDC=0.50

# ============================================================================
# PRIVATE CONFIGURATION - Get fresh values from Vercel
# ============================================================================

ARC_RPC_URL=https://rpc.testnet.arc.network
PRIVATE_KEY=

# Circle Wallet SDK
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_BASE_URL=https://api.circle.com
CIRCLE_WALLET_BLOCKCHAIN=ARC-TESTNET
CIRCLE_WALLET_ACCOUNT_TYPE=SCA

CIRCLE_APP_KIT_API_KEY=

# ============================================================================
# AGENT CONFIGURATION
# ============================================================================

AGENT_PRIVATE_KEY=
PRESTO_AGENT_API_KEY=

AGENT_ERC8004_ID=16339
PRESTO_AGENT_RESOLVER_ADDRESS=

PRESTO_AGENT_ACTIVE_MARKET_CAP=10
PRESTO_AGENT_PER_RUN_CAP=15

# Spend controls for autonomous agent USDC transfers
PRESTO_AGENT_MAX_TRANSFER_USDC=5
X402_MAX_PRICE_USDC=1
# Optional comma-separated allowlist of x402 payment recipients (empty = allow any valid address)
X402_ALLOWED_RECIPIENTS=

# ============================================================================
# LLM PROVIDER KEYS
# ============================================================================

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
